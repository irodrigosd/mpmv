{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/curso",
      "destination": "/curso.html"
    },
    {
      "source": "/curso/",
      "destination": "/curso.html"
    },
    {
      "source": "/assets/css/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/js/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/images/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/downloads/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin-blog.html"
    },
    {
      "source": "/admin/blog/",
      "destination": "/admin-blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/mentoria",
      "destination": "/mentoria.html"
    },
    {
      "source": "/mentoria/",
      "destination": "/mentoria.html"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    },
    {
      "source": "/leads/",
      "destination": "/leads.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/politica-de-privacidade/",
      "destination": "/politica-de-privacidade.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artigo-seo",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/artigo-seo/",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/guia-mais-persuasao-mais-vendas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guia-mais-persuasao-mais-vendas/",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/blog-admin.js": {
      "maxDuration": 30
    },
    "api/leads.js": {
      "maxDuration": 20
    },
    "api/guia.js": {
      "maxDuration": 10
    },
    "api/mentoria.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/curso",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/curso/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/guia-pratico-persuasao-pra-vender-todo-santo-dia.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Guia-Pratico-Persuasao-pra-Vender-Todo-Santo-Dia.pdf\"; filename*=UTF-8''%5BGuia%20Pr%C3%A1tico%5D%20Persuas%C3%A3o%20pra%20Vender%20Todo%20Santo%20Dia.pdf"
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    },
    {
      "source": "/mentoria(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
