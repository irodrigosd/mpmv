{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/assets/css/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/js/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/images/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/downloads/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/curso",
      "destination": "/curso.html"
    },
    {
      "source": "/curso/",
      "destination": "/curso.html"
    },
    {
      "source": "/obrigado",
      "destination": "/obrigado.html"
    },
    {
      "source": "/obrigado/",
      "destination": "/obrigado.html"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    },
    {
      "source": "/leads/",
      "destination": "/leads.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/persuasao-para-infoprodutores",
      "destination": "/persuasao-para-infoprodutores.html"
    },
    {
      "source": "/blog/persuasao-para-infoprodutores/",
      "destination": "/persuasao-para-infoprodutores.html"
    },
    {
      "source": "/blog/o-que-e-copywriting",
      "destination": "/o-que-e-copywriting.html"
    },
    {
      "source": "/blog/o-que-e-copywriting/",
      "destination": "/o-que-e-copywriting.html"
    },
    {
      "source": "/blog/gatilhos-mentais",
      "destination": "/gatilhos-mentais.html"
    },
    {
      "source": "/blog/gatilhos-mentais/",
      "destination": "/gatilhos-mentais.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin/blog.html"
    },
    {
      "source": "/admin/blog/",
      "destination": "/admin/blog.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artigo-seo",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/artigo-seo/",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/blog/copywriting-o-que-e-como-aplicar",
      "destination": "/blog/o-que-e-copywriting/",
      "permanent": true
    },
    {
      "source": "/blog/copywriting-o-que-e-como-aplicar/",
      "destination": "/blog/o-que-e-copywriting/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}