{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/guia.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/mentoria",
      "destination": "/mentoria.html"
    },
    {
      "source": "/mentoria/",
      "destination": "/mentoria.html"
    },
    {
      "source": "/curso",
      "destination": "/curso.html"
    },
    {
      "source": "/curso/",
      "destination": "/curso.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin/blog.html"
    },
    {
      "source": "/admin/blog/",
      "destination": "/admin/blog.html"
    },
    {
      "source": "/backup",
      "destination": "/backup.html"
    },
    {
      "source": "/backup/",
      "destination": "/backup.html"
    }
  ],
  "redirects": [
    {
      "source": "/aula",
      "destination": "https://meet.google.com/bkz-xkiu-bxw",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/curso",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/curso/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ]
}
