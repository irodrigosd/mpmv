{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/assets/css/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/js/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/images/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/downloads/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/curso",
      "destination": "/curso.html"
    },
    {
      "source": "/curso/",
      "destination": "/curso.html"
    },
    {
      "source": "/mentoria",
      "destination": "/mentoria.html"
    },
    {
      "source": "/mentoria/",
      "destination": "/mentoria.html"
    },
    {
      "source": "/obrigado",
      "destination": "/obrigado.html"
    },
    {
      "source": "/obrigado/",
      "destination": "/obrigado.html"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    },
    {
      "source": "/leads/",
      "destination": "/leads.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/persuasao-para-infoprodutores",
      "destination": "/persuasao-para-infoprodutores.html"
    },
    {
      "source": "/blog/persuasao-para-infoprodutores/",
      "destination": "/persuasao-para-infoprodutores.html"
    },
    {
      "source": "/blog/o-que-e-copywriting",
      "destination": "/o-que-e-copywriting.html"
    },
    {
      "source": "/blog/o-que-e-copywriting/",
      "destination": "/o-que-e-copywriting.html"
    },
    {
      "source": "/blog/gatilhos-mentais",
      "destination": "/gatilhos-mentais.html"
    },
    {
      "source": "/blog/gatilhos-mentais/",
      "destination": "/gatilhos-mentais.html"
    },
    {
      "source": "/blog/copywriting-para-redes-sociais",
      "destination": "/copywriting-para-redes-sociais.html"
    },
    {
      "source": "/blog/copywriting-para-redes-sociais/",
      "destination": "/copywriting-para-redes-sociais.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin/blog.html"
    },
    {
      "source": "/admin/blog/",
      "destination": "/admin/blog.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artigo-seo",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/artigo-seo/",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/blog/copywriting-o-que-e-como-aplicar",
      "destination": "/blog/o-que-e-copywriting/",
      "permanent": true
    },
    {
      "source": "/blog/copywriting-o-que-e-como-aplicar/",
      "destination": "/blog/o-que-e-copywriting/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/curso",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/curso/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/curso.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/obrigado",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/obrigado/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/guia-pratico-persuasao-pra-vender-todo-santo-dia.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"[Guia Pratico] Persuasao Pra Vender Todo Santo Dia.pdf\"; filename*=UTF-8''%5BGuia%20Pr%C3%A1tico%5D%20Persuasao%20Pra%20Vender%20Todo%20Santo%20Dia.pdf"
        }
      ]
    },
    {
      "source": "/assets/downloads/guia-pratico-persuasao-pra-vender-todo-santo-dia.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"[Guia Pratico] Persuasao Pra Vender Todo Santo Dia.pdf\"; filename*=UTF-8''%5BGuia%20Pr%C3%A1tico%5D%20Persuasao%20Pra%20Vender%20Todo%20Santo%20Dia.pdf"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
