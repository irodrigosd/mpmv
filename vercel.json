{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/curso",
      "destination": "/curso.html"
    },
    {
      "source": "/curso/",
      "destination": "/curso.html"
    },
    {
      "source": "/assets/css/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/js/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/images/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/assets/downloads/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin-blog.html"
    },
    {
      "source": "/admin/blog/",
      "destination": "/admin-blog.html"
    },
    {
      "source": "/blog/como-usar-persuasao-para-vender-mais",
      "destination": "/como-usar-persuasao-para-vender-mais.html"
    },
    {
      "source": "/blog/como-usar-persuasao-para-vender-mais/",
      "destination": "/como-usar-persuasao-para-vender-mais.html"
    },
    {
      "source": "/blog/persuasao-para-infoprodutores",
      "destination": "/persuasao-para-infoprodutores.html"
    },
    {
      "source": "/blog/persuasao-para-infoprodutores/",
      "destination": "/persuasao-para-infoprodutores.html"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    },
    {
      "source": "/leads/",
      "destination": "/leads.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/politica-de-privacidade/",
      "destination": "/politica-de-privacidade.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/artigo-seo",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/artigo-seo/",
      "destination": "/blog/persuasao-para-infoprodutores/",
      "permanent": true
    },
    {
      "source": "/guia-mais-persuasao-mais-vendas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guia-mais-persuasao-mais-vendas/",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/blog-admin.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
